# Registry entry scope02 -- second asyn-scope IOC instance on the target.
# Slot 2 (console 21020), next to scope01's slot 1. CA/PVA stay dynamic; pin
# them with
#   CA_PORT=21023
#   PVA_PORT=21024
# when clients need a fixed port.

IOC_INSTANCE_INDEX=2
IOC_APP_DIR=/opt/epics/iocs/asyn-scope-ioc
IOC_PATH=iocBoot/ioctestAsynPortDriver
IOC_APP_NAME=testAsynPortDriver
P=ioc1:
R=scope1:
IOC_STATE=/var/lib/asyn-scope-ioc/scope02
