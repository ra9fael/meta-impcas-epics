# Registry entry tapd02 -- second testAsynPortDriver instance on the target.
# Slot 2 (console 21020), next to tapd01's slot 1. CA/PVA stay dynamic; pin
# them with
#   CA_PORT=21023
#   PVA_PORT=21024
# when clients need a fixed port.

IOC_INSTANCE_INDEX=2
IOC_APP_DIR=/opt/epics/iocs/tapd
IOC_PATH=iocBoot/ioctestAsynPortDriver
IOC_APP_NAME=testAsynPortDriver
P=TAPD02:
R=scope1:
# The class default again, spelled out: /var/lib/epics-ioc/<instance>.
IOC_STATE=/var/lib/epics-ioc/tapd02
