<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>tapd launcher</name>
  <x>280</x>
  <y>200</y>
  <width>240</width>
  <height>150</height>
  <widget type="label" version="2.0.0">
    <name>heading</name>
    <text>tapd instances</text>
    <x>10</x>
    <y>10</y>
    <width>220</width>
    <height>24</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>tapd01</name>
    <actions>
      <action type="open_display">
        <file>tapd.bob</file>
        <macros>
          <P>TAPD01:</P>
          <R>scope1:</R>
        </macros>
        <target>window</target>
        <description>tapd01 scope</description>
      </action>
    </actions>
    <text>tapd01</text>
    <x>20</x>
    <y>50</y>
    <width>200</width>
    <height>32</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>tapd02</name>
    <actions>
      <action type="open_display">
        <file>tapd.bob</file>
        <macros>
          <P>TAPD02:</P>
          <R>scope1:</R>
        </macros>
        <target>window</target>
        <description>tapd02 scope</description>
      </action>
    </actions>
    <text>tapd02</text>
    <x>20</x>
    <y>95</y>
    <width>200</width>
    <height>32</height>
    <tooltip>$(actions)</tooltip>
  </widget>
</display>
