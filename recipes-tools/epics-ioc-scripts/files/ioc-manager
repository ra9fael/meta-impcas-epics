# Convenience front end over the instance registry and systemd, in the spirit
# of NSLS2's manage-iocs. Reads the same two registry layers as the runtime
# (fleet: /etc/epics/instances, machine: /boot/iocs) and drives systemctl for
# the epics-ioc@ instances.

set -e

RUNTIME=/usr/libexec/epics-ioc
[ -r "$RUNTIME/epics-ioc-env" ] || { echo "$0: missing $RUNTIME/epics-ioc-env" >&2; exit 1; }
. "$RUNTIME/epics-ioc-env"

usage() {
    echo "Usage: $0 <command> [args]"
    echo "  list             instances from both registry layers, with state"
    echo "  report [name]    name / slot / console port / prefix / application"
    echo "  status [name]    systemctl status for one or all instances"
    echo "  start <name>     start one instance"
    echo "  stop <name>      stop one instance"
    echo "  restart <name>   restart one instance"
    echo "  enable <name>    enable auto-start at boot"
    echo "  disable <name>   disable auto-start at boot"
    echo "  startall         start every registered instance"
    echo "  stopall          stop every registered instance"
    exit 2
}

# Print "name layer" for every known instance; the machine layer wins.
registry_entries() {
    _seen=""
    for _f in "$ENV_ROOT"/*.env "$MACHINE_ENV_ROOT"/*/*.env; do
        [ -f "$_f" ] || continue
        _name=$(basename "$_f" .env)
        case "$_seen" in
            *" $_name "*) ;;
            *) _seen="$_seen $_name "
               if [ "${_f#"$MACHINE_ENV_ROOT"/}" != "$_f" ]; then
                   echo "$_name machine"
               else
                   echo "$_name fleet"
               fi ;;
        esac
    done
}

entries() {
    registry_entries | cut -d' ' -f1
}

# Last non-empty value of KEY across the two registry layers.
get_key() {
    _v=""
    for _f in "$ENV_ROOT/$1.env" "$MACHINE_ENV_ROOT/$1/$1.env"; do
        [ -f "$_f" ] || continue
        _val=$(sed -n "s/^[[:space:]]*$2=[[:space:]]*//p" "$_f" | tail -n 1)
        [ -n "$_val" ] && _v=$_val
    done
    echo "$_v"
}

# First line of a systemctl query (systemctl may print several lines even
# for a simple query; the first is the answer).
unit_state() {
    systemctl "$1" "epics-ioc@$2.service" 2>/dev/null | head -n1
}

cmd=${1:-}
[ -n "$cmd" ] || usage

case "$cmd" in
    list)
        printf "%-16s %-8s %-10s %s\n" INSTANCE LAYER ENABLED ACTIVE
        registry_entries | while read -r name layer; do
            enabled=$(unit_state is-enabled "$name")
            active=$(unit_state is-active "$name")
            printf "%-16s %-8s %-10s %s\n" "$name" "$layer" "${enabled:--}" "${active:-inactive}"
        done
        ;;
    report)
        if [ -n "$2" ]; then
            _names="$2"
        else
            _names=$(entries)
        fi
        printf "%-16s %-5s %-7s %-14s %-9s %s\n" INSTANCE SLOT PORT P R APP
        for name in $_names; do
            slot=$(get_key "$name" IOC_INSTANCE_INDEX)
            slot=${slot:-0}
            p=$(get_key "$name" P)
            r=$(get_key "$name" R)
            app=$(get_key "$name" IOC_APP_DIR)
            printf "%-16s %-5s %-7s %-14s %-9s %s\n" "$name" "$slot" "$(( PORT_BASE + slot * 10 ))" "${p:--}" "${r:--}" "${app:--}"
        done
        ;;
    status)
        if [ -n "$2" ]; then
            exec systemctl status "epics-ioc@$2.service"
        fi
        for name in $(entries); do
            active=$(unit_state is-active "$name")
            printf "%-16s %s\n" "$name" "${active:-inactive}"
        done
        ;;
    start|stop|restart|enable|disable)
        [ -n "$2" ] || { echo "usage: $0 $cmd <instance-name>" >&2; exit 2; }
        systemctl "$cmd" "epics-ioc@$2.service"
        ;;
    startall)
        for name in $(entries); do
            echo "starting $name"
            systemctl start "epics-ioc@$name.service"
        done
        ;;
    stopall)
        for name in $(entries); do
            echo "stopping $name"
            systemctl stop "epics-ioc@$name.service"
        done
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "unknown command: $cmd" >&2
        usage
        ;;
esac
